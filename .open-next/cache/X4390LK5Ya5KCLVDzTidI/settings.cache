de variant\",\"molecularConsequence\":\"missense variant\",\"proteinChange\":\"H1686Y\",\"rsid\":\"rs1555579648\",\"classification\":\"Likely pathogenic\",\"reviewStatus\":\"reviewed by expert panel\",\"lastEvaluated\":\"2025-08-18\",\"fdaRecognised\":true,\"submissionCount\":10,\"conditions\":[\"BRCA1-related cancer predisposition\"],\"location\":{\"assembly\":\"GRCh38\",\"chr\":\"17\",\"band\":\"17q21.31\",\"start\":\"43067626\",\"stop\":\"43067626\"},\"peakAlleleFrequency\":null,\"citations\":[{\"pmid\":\"39142283\",\"title\":\"Evidence-based recommendations for gene-specific ACMG/AMP variant classification from the ClinGen ENIGMA BRCA1 and BRCA2 Variant Curation Expert Panel.\",\"journal\":\"Am J Hum Genet\",\"year\":\"2024\"},{\"pmid\":\"38645101\",\"title\":\"Defining and Reducing Variant Classification Disparities.\",\"journal\":\"medRxiv\",\"year\":\"2024\"},{\"pmid\":\"35802134\",\"title\":\"ACMG SF v3.1 list for reporting of secondary findings in clinical exome and genome sequencing: A policy statement of the American College of Medical Genetics and Genomics (ACMG).\",\"journal\":\"Genet Med\",\"year\":\"2022\"},{\"pmid\":\"34793697\",\"title\":\"Closing the gap: Systematic integration of multiplexed functional data resolves variants of uncertain significance in BRCA1, TP53, and PTEN.\",\"journal\":\"Am J Hum Genet\",\"year\":\"2021\"},{\"pmid\":\"34242744\",\"title\":\"Customizing local and systemic therapies for women with early breast cancer: the St. Gallen International Consensus Guidelines for treatment of early breast cancer 2021.\",\"journal\":\"Ann Oncol\",\"year\":\"2021\"},{\"pmid\":\"34012068\",\"title\":\"ACMG SF v3.0 list for reporting of secondary findings in clinical exome and genome sequencing: a policy statement of the American College of Medical Genetics and Genomics (ACMG).\",\"journal\":\"Genet Med\",\"year\":\"2021\"},{\"pmid\":\"33410258\",\"title\":\"Risk assessment and genetic counseling for hereditary breast and ovarian cancer syndromes-Practice resource of the National Society of Genetic Counselors.\",\"journal\":\"J Genet Couns\",\"year\":\"2021\"},{\"pmid\":\"31479213\",\"title\":\"Risk Assessment, Genetic Counseling, and Genetic Testing for BRCA1/2-Related Cancer in Women: A Systematic Review for the U.S. Preventive Services Task Force\",\"journal\":\"Agency for Healthcare Research and Quality (US)\",\"year\":\"2019\"}]},\"recordedCode\":\"VUS\",\"currentCode\":\"LIKELY_PATHOGENIC\",\"verdict\":{\"type\":\"CLASSIFICATION_DRIFT\",\"direction\":\"toward-pathogenic\",\"rationale\":[\"Recorded interpretation normalised to Uncertain significance.\",\"Current interpretation normalised to Likely pathogenic.\",\"The interpretation crossed into the clinically actionable band, so records carrying it may need review.\"]},\"changeType\":\"CLASSIFICATION_DRIFT\",\"confidence\":{\"stars\":3,\"label\":\"Reviewed by expert panel\",\"strength\":\"Strong\"},\"regional\":{\"variantKey\":\"BRCA1:c.5056C>T\",\"assertion\":\"LIKELY_PATHOGENIC\",\"observations\":0,\"cohortSize\":3042,\"regionalFrequency\":0,\"globalFrequency\":0,\"contributingCentres\":[\"Regional Hereditary Cancer Network\"],\"lastUpdated\":\"2026-02-18\",\"note\":\"Absent from gnomAD v4 entirely, including its ~3,000 Middle Eastern individuals. Regional data neither supports nor contradicts the expert-panel reclassification; the global reading stands.\",\"citations\":[{\"pmid\":\"42137137\",\"title\":\"Ancestry-informative markers and variants of uncertain significance on hereditary cancer panels.\",\"journal\":\"Front Oncol\",\"year\":\"2026\"},{\"pmid\":\"35330423\",\"title\":\"Middle Eastern Genetic Variation Improves Clinical Annotation of the Human Genome.\",\"journal\":\"J Pers Med\",\"year\":\"2022\"}]},\"regionalDisagreement\":{\"conflicting\":false,\"severity\":\"none\",\"reason\":\"Both sources place this variant in the same band.\",\"globalCode\":\"LIKELY_PATHOGENIC\",\"regionalCode\":\"LIKELY_PATHOGENIC\"},\"impactedPatients\":[{\"id\":\"VP-10247\",\"ageBand\":\"45-54\",\"sex\":\"Female\",\"variantKey\":\"BRCA1:c.5056C>T\",\"testedOn\":\"2023-03-14\",\"reportingLab\":\"Genomics Core Laboratory\",\"orderingDepartment\":\"Clinical Genetics\",\"clinicalOwner\":\"Dr. L. Haddad\",\"lastContact\":\"2023-04-02\",\"reviewState\":\"Not reviewed\",\"indication\":\"Family history of breast cancer\"},{\"id\":\"VP-10284\",\"ageBand\":\"35-44\",\"sex\":\"Female\",\"variantKey\":\"BRCA1:c.5056C>T\",\"testedOn\":\"2023-05-09\",\"reportingLab\":\"Genomics Core Laboratory\",\"orderingDepartment\":\"Breast Surgery\",\"clinicalOwner\":\"Dr. N. Farouk\",\"lastContact\":\"2023-06-01\",\"reviewState\":\"Not reviewed\",\"indication\":\"Diagnostic work-up\"},{\"id\":\"VP-10321\",\"ageBand\":\"55-64\",\"sex\":\"Female\",\"variantKey\":\"BRCA1:c.5056C>T\",\"testedOn\":\"2023-08-21\",\"reportingLab\":\"Partner Reference Laboratory\",\"orderingDepartment\":\"Oncology\",\"clinicalOwner\":\"Dr. R. Okonjo\",\"lastContact\":\"2024-01-15\",\"reviewState\":\"Not reviewed\",\"indication\":\"Treatment planning\"},{\"id\":\"VP-10358\",\"ageBand\":\"25-34\",\"sex\":\"Male\",\"variantKey\":\"BRCA1:c.5056C>T\",\"testedOn\":\"2023-11-02\",\"reportingLab\":\"Genomics Core Laboratory\",\"orderingDepartment\":\"Clinical Genetics\",\"clinicalOwner\":\"Dr. L. Haddad\",\"lastContact\":\"2023-11-20\",\"reviewState\":\"Not reviewed\",\"indication\":\"Cascade testing following a family result\"}],\"impactedRecordCount\":4,\"priority\":{\"level\":\"CRITICAL\",\"score\":90,\"factors\":[{\"label\":\"Moved into the actionable band\",\"detail\":\"Uncertain significance to Likely pathogenic.\",\"weight\":60},{\"label\":\"4 records on file\",\"detail\":\"Historical results carrying this variant that a reviewer would reassess.\",\"weight\":20},{\"label\":\"High review confidence\",\"detail\":\"The current classification carries expert-panel or guideline review.\",\"weight\":10}]},\"requiresReview\":true,\"summary\":\"Since the 2023 report, the consensus for BRCA1 c.5056C>T has moved from uncertain significance to likely pathogenic. That reading rests on 10 submissions at strong review confidence, reviewed by expert panel. That crosses the clinically actionable boundary, so management guidance issued on the original interpretation may no longer be the right guidance. 4 records on file carry this variant and have not yet been reassessed.\",\"pipeline\":[{\"label\":\"Historical record retrieved\",\"detail\":\"BRCA1 c.5056C>T reported as Uncertain significance on 2023-03-14.\"},{\"label\":\"Variant normalised\",\"detail\":\"Resolved to ClinVar VCV000531444 (rs1555579648) and keyed as BRCA1:c.5056C>T.\"},{\"label\":\"Current evidence retrieved\",\"detail\":\"Served from the bundled demo snapshot: Likely pathogenic, 10 submissions, reviewed by expert panel.\"},{\"label\":\"Classification difference detected\",\"detail\":\"Recorded interpretation normalised to Uncertain significance. Current interpretation normalised to Likely pathogenic. The interpretation crossed into the clinically actionable band, so records carrying it may need review.\"},{\"label\":\"Regional sources compared\",\"detail\":\"Regional index asserts Likely pathogenic, consistent with the global reading.\"},{\"label\":\"Impacted records identified\",\"detail\":\"12,482 findings checked; 4 carry this variant.\"},{\"label\":\"Evidence brief generated\",\"detail\":\"Composed from the structured fields of the cited records above.\"},{\"label\":\"Human review requested\",\"detail\":\"VariantPulse does not change any record. A clinician decides what happens next.\"}],\"caseId\":\"VP-R-2026-001\"},{\"variant\":{\"key\":\"BRCA2:c.7847C>T\",\"gene\":\"BRCA2\",\"hgvsCoding\":\"c.7847C>T\",\"proteinChange\":\"p.Ser2616Phe\",\"clinvarId\":\"630829\",\"recordedClassification\":\"VUS\",\"recordedOn\":\"2023-06-19\",\"recordedEvidenceNote\":\"Missense change in the DNA-binding domain. Classified as uncertain significance; functional data not yet available.\",\"co