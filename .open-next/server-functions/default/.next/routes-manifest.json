{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/patients/[id]",
      "regex": "^/patients/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/patients/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/review/[caseId]",
      "regex": "^/review/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcaseId": "nxtPcaseId"
      },
      "namedRegex": "^/review/(?<nxtPcaseId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/variants/[key]",
      "regex": "^/variants/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/variants/(?<nxtPkey>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/activity",
      "regex": "^/activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/activity(?:/)?$"
    },
    {
      "page": "/apple-icon.png",
      "regex": "^/apple\\-icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apple\\-icon\\.png(?:/)?$"
    },
    {
      "page": "/evidence",
      "regex": "^/evidence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/evidence(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/patients",
      "regex": "^/patients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/patients(?:/)?$"
    },
    {
      "page": "/regional",
      "regex": "^/regional(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/regional(?:/)?$"
    },
    {
      "page": "/review",
      "regex": "^/review(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/review(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/sources",
      "regex": "^/sources(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sources(?:/)?$"
    },
    {
      "page": "/variants",
      "regex": "^/variants(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/variants(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}