.\",\"citations\":[{\"pmid\":\"41496868\",\"title\":\"Highly Effective Modulator Therapy in Cystic Fibrosis: Addressing Unusual Variants in the Middle East.\",\"journal\":\"Pulm Med\",\"year\":\"2025\"},{\"pmid\":\"35330423\",\"title\":\"Middle Eastern Genetic Variation Improves Clinical Annotation of the Human Genome.\",\"journal\":\"J Pers Med\",\"year\":\"2022\"}]},\"regionalDisagreement\":{\"conflicting\":true,\"severity\":\"moderate\",\"reason\":\"The sources place this variant in different bands without crossing the actionable boundary.\",\"globalCode\":\"VUS\",\"regionalCode\":\"LIKELY_BENIGN\"},\"impactedPatients\":[{\"id\":\"VP-10987\",\"ageBand\":\"25-34\",\"sex\":\"Male\",\"variantKey\":\"CFTR:c.601G>A\",\"testedOn\":\"2023-05-02\",\"reportingLab\":\"Molecular Pathology Unit\",\"orderingDepartment\":\"Clinical Genetics\",\"clinicalOwner\":\"Dr. L. Haddad\",\"lastContact\":\"2023-05-30\",\"reviewState\":\"Reviewed\",\"indication\":\"Premarital screening follow-up\"}],\"impactedRecordCount\":1,\"priority\":{\"level\":\"MEDIUM\",\"score\":45,\"factors\":[{\"label\":\"Regional evidence conflicts\",\"detail\":\"Regional and global sources reach different conclusions.\",\"weight\":30},{\"label\":\"1 record on file\",\"detail\":\"Historical results carrying this variant that a reviewer would reassess.\",\"weight\":5},{\"label\":\"High review confidence\",\"detail\":\"The current classification carries expert-panel or guideline review.\",\"weight\":10}]},\"requiresReview\":true,\"summary\":\"Global and regional evidence disagree on CFTR c.601G>A. The global consensus is uncertain significance, drawn from 21 submissions. The regional index asserts likely benign on 4 observations across a cohort of 3,030. One record on file carries this variant and has not yet been reassessed.\",\"pipeline\":[{\"label\":\"Historical record retrieved\",\"detail\":\"CFTR c.601G>A reported as Uncertain significance on 2023-05-02.\"},{\"label\":\"Variant normalised\",\"detail\":\"Resol